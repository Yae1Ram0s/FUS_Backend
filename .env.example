# Copia este archivo a .env y completa los valores reales.
# .env nunca se sube al repositorio (ver .gitignore).

# ── Seguridad ──────────────────────────────────────────────────────────────
DEBUG=False
# Genera una clave única y secreta por ambiente, nunca reutilices esta ni la
# dejes vacía en producción (con DEBUG=False la app no arranca sin ella).
SECRET_KEY=change-me-to-a-long-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,https://localhost:5173
CORS_ORIGINS=http://localhost:5173

# URL pública del frontend (se usa para armar links absolutos en correos)
FRONTEND_URL=http://localhost:5173

# ── Base de datos (MySQL) ────────────────────────────────────────────────────
DB_NAME=SCS_REFACTOR
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# ── Channel layer (WebSockets) ───────────────────────────────────────────────
# Opcional: si se define, se usa Redis (requiere channels-redis, ver
# requirements.txt) en vez de InMemoryChannelLayer. InMemoryChannelLayer solo
# funciona correctamente con un único worker/proceso.
# REDIS_URL=redis://localhost:6379/0

# ── Correo (envío de OTP y notificaciones) ───────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=change-me@example.com
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@anam.gob.mx
